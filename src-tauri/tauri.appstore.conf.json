{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DoodleRay VPN",
  "identifier": "com.doodleray.doodleray",
  "app": {
    "security": {
      "capabilities": ["appstore"]
    }
  },
  "bundle": {
    "targets": ["app"],
    "category": "Utility",
    "createUpdaterArtifacts": false,
    "resources": {
      "resources/PrivacyInfo.xcprivacy": "PrivacyInfo.xcprivacy",
      "resources/third-party-notices.txt": "resources/third-party-notices.txt"
    },
    "macOS": {
      "bundleVersion": "60000",
      "entitlements": "macos/profiles/DoodleRayHost.entitlements",
      "minimumSystemVersion": "12.0",
      "files": {
        "embedded.provisionprofile": "macos/profiles/DoodleRayHost.provisionprofile",
        "PlugIns/DoodleRayVPN.appex": "macos/DerivedData/Build/Products/Release/DoodleRayVPN.appex"
      }
    }
  }
}
