{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "xray-core/*": "xray-core/",
      "sing-box*": "./",
      "wintun*": "./",
      "DoodleRayService.exe": "DoodleRayService.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "./sign-windows-if-configured.ps1",
          "%1"
        ]
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
