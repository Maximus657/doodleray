{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DoodleRay",
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "xray-core/*": "xray-core/",
      "sing-box*": "./",
      "wintun*": "./",
      "DoodleRayService.exe": "DoodleRayService.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
